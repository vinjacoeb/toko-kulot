APP_NAME="Toko Kulot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona waktu (Asia/Jakarta), locale (id), dan fallback locale (en) diatur di
# config/app.php, bukan di .env — PRD §4.3 (bahasa UI Indonesia).

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL 8, nama database `toko-kulot` (pakai backtick saat query manual).
# Kata sandi diisi pemilik di .env — jangan pernah di-commit.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toko-kulot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Unggahan (logo, gambar produk) disajikan lewat symlink public/storage (PRD A7).
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@tokokulot.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Midtrans — QRIS saja (PRD §8). Nilai rahasia diisi pemilik.
# Sumber kebenaran kredensial = berkas .env ini; dibaca config/midtrans.php.
# Kolom Midtrans di /admin/pengaturan (client key, mode produksi) hanya CATATAN —
# nilai di sana TIDAK dibaca jalur pembayaran QRIS.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
# Produksi: true + kunci PRODUKSI (kunci sandbox berawalan "SB-"; jangan dicampur).
MIDTRANS_IS_PRODUCTION=false
# true = mode fake: QRIS dummy tanpa kredensial, hanya untuk pengembangan lokal.
# Bawaan false: isi MIDTRANS_CLIENT_KEY & MIDTRANS_SERVER_KEY agar QRIS asli dipakai.
# Selama true (atau SERVER_KEY kosong) UI menandai "MODE UJI" dan QRIS tidak bisa ditransfer.
MIDTRANS_FAKE=false
# Masa berlaku tagihan QRIS dalam menit. Bawaan 5 (keputusan pemilik 21 Okt 2026).
# Satu nilai untuk custom_expiry Midtrans DAN kolom payments.expires_at.
# Ubah hanya bila pemilik mengubah ketentuan, lalu jalankan php artisan config:clear.
MIDTRANS_EXPIRY_MINUTES=5
# Acquirer QRIS Core API yang sah: gopay (QRIS GoPay, bawaan) atau "airpay shopee".
# Nilai lain (termasuk other_qris — metode Snap, bukan acquirer) tidak sah;
# other_qris dipetakan otomatis ke "airpay shopee" agar .env lama tetap jalan.
# Harus kanal yang AKTIF di dashboard Midtrans; bila belum, server mencoba
# acquirer satunya otomatis. Salah tulis/kosong = gopay. Ubah lalu config:clear.
# (Parameter lama enabled_payments=["other_qris"] dihapus: ia milik Snap dan membuat
# Midtrans menjawab 402 "Payment channel is not activated".)
MIDTRANS_QRIS_ACQUIRER=gopay
# URL notifikasi Midtrans (diisi saat produksi, mis. https://tokoku.id/midtrans/notification).
# Catatan: yang benar-benar dipanggil Midtrans adalah URL di dashboard Midtrans
# (Settings -> Configuration -> Payment Notification URL); nilai ini hanya dokumentasi.
MIDTRANS_NOTIFICATION_URL=/midtrans/notification

VITE_APP_NAME="${APP_NAME}"
